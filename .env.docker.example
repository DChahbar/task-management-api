# Copy to .env for docker compose: cp .env.docker.example .env

# Required — use a long random string in production
SECRET_KEY=replace_this_with_a_long_random_secret

# URL where the browser loads the React app (for CORS)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# API URL baked into the frontend build (browser must reach this host)
VITE_API_URL=http://localhost:8000
